# Copy this file to .env and fill in the real values:  cp .env.example .env
#
# .env is git-ignored; this file is committed so anyone cloning the repo knows
# which keys to set. Never put real values in here.

# --- Database (A3) -------------------------------------------------------
# Running the app on your machine against the container:  host is localhost
# Running the app inside docker compose:                  host is db
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# Port the API listens on.
PORT=3000

# --- Supabase Auth (A4) --------------------------------------------------
# From your Supabase dashboard: Project Settings -> API.
#
# SUPABASE_KEY must be the PUBLIC key — labelled "anon public" on older
# dashboards, or "publishable" (sb_publishable_...) on newer ones. It is
# designed to be safe in client code and is restricted by row-level security.
#
# Never use the service_role / secret key here. That one bypasses every
# security rule in the project, and anything holding it can read and write
# every row belonging to every user.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_or_publishable_key
