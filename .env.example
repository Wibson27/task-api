# Copy this file to .env and adjust if needed:  cp .env.example .env
#
# .env is git-ignored; this file is committed so anyone cloning the repo knows
# which keys to set. Never put a real production password in here.

# How the app reaches Postgres.
#   Running the app on your machine against the container:  host is localhost
#   Running the app inside docker compose:                  host is db
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# Port the API listens on.
PORT=3000
